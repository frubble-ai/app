{
	"$schema": "https://turborepo.com/schema.json",
	"globalDependencies": [
		"tsconfig.json",
		"biome.json",
		"eslint.config.mjs",
		"vitest.shared.ts",
		".nvmrc"
	],
	"globalEnv": [
		"NODE_ENV"
	],
	"globalPassThroughEnv": [
		"CI",
		"FORCE_COLOR",
		"GITHUB_*",
		"ACTIONS_*",
		"TURBO_*",
		"DOCKER_HOST",
		"TESTCONTAINERS_*"
	],
	"tasks": {
		"codegen": {
			"outputs": [
				"src/__generated__/**"
			],
			"inputs": [
				"codegen.yml",
				"schema/**",
				"../../packages/gql/schema/**"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": [
				"codegen",
				"^codegen"
			]
		},
		"dev:api": {
			"cache": false,
			"persistent": true,
			"dependsOn": [
				"codegen",
				"^codegen"
			]
		},
		"dev:worker": {
			"cache": false,
			"persistent": true,
			"dependsOn": [
				"codegen",
				"^codegen"
			]
		},
		"typecheck": {
			"dependsOn": [
				"codegen",
				"^codegen"
			]
		},
		"lint": {
			"dependsOn": [
				"codegen",
				"^codegen"
			]
		},
		"format": {},
		"format:write": {
			"cache": false
		},
		"test": {
			"dependsOn": [
				"codegen",
				"^codegen"
			]
		},
		"test:coverage": {
			"dependsOn": [
				"codegen",
				"^codegen"
			],
			"outputs": [
				"coverage/**"
			]
		}
	}
}
