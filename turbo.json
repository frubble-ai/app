{
	"$schema": "https://turborepo.com/schema.json",
	"globalDependencies": [
		"tsconfig.json",
		"biome.json",
		"eslint.config.mjs",
		"vitest.shared.ts",
		".nvmrc"
	],
	"globalEnv": ["NODE_ENV"],
	"globalPassThroughEnv": [
		"CI",
		"FORCE_COLOR",
		"GITHUB_*",
		"ACTIONS_*",
		"TURBO_*",
		"DOCKER_HOST",
		"TESTCONTAINERS_*"
	],
	"tasks": {
		"codegen": {
			"passThroughEnv": ["COMPOSIO_API_KEY"],
			"outputs": [
				"src/__generated__/**",
				"src/gql/documents.ts",
				"src/gql/operations.ts",
				"src/gql/generated.ts",
				"src/testing/__generated__/**"
			],
			"inputs": [
				"codegen.yml",
				"codegen/**",
				"src/composio/**/output-patch.ts",
				"src/__codegen__/**",
				"schema/**",
				"../../packages/gql/schema/**",
				"../../packages/gql/operations/**"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["codegen", "^codegen"]
		},
		"dev:api": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["codegen", "^codegen"]
		},
		"dev:worker": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["codegen", "^codegen"],
			"passThroughEnv": ["WORKER_PORT"]
		},
		"typecheck": {
			"dependsOn": ["codegen", "^codegen"]
		},
		"lint": {
			"dependsOn": ["codegen", "^codegen"]
		},
		"format": {},
		"format:write": {
			"cache": false
		},
		"test": {
			"dependsOn": ["codegen", "^codegen"]
		},
		"test:coverage": {
			"dependsOn": ["codegen", "^codegen"],
			"outputs": ["coverage/**"]
		},
		"build": {
			"dependsOn": ["codegen", "^codegen"],
			"outputs": [".next/**", "!.next/cache/**"]
		}
	}
}
