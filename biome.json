{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/.turbo",
			"!**/dist",
			"!**/coverage",
			"!**/__generated__",
			"!**/.next",
			"!**/next-env.d.ts",
			"!packages/react-sdk/src/gql/documents.ts",
			"!packages/react-sdk/src/gql/operations.ts",
			"!packages/react-sdk/src/gql/generated.ts"
		]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	}
}
