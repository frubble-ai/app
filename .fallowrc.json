{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"ignorePatterns": [
		"**/__mocks__/**",
		"**/__generated__/**",
		"**/.next/**",
		"packages/gql/operations/**"
	],
	"dynamicallyLoaded": [
		"**/testing/mock-*.{ts,tsx}",
		"**/__mocks__/**",
		"packages/react-sdk/codegen/*.cjs"
	],
	"rules": {
		"unused-types": "error"
	},
	"ignoreDependencies": [
		"graphql-codegen-typescript-validation-schema",
		"@graphql-typed-document-node/core"
	]
}
