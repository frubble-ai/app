{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"allowJs": false,
		"types": ["node", "vitest/globals"],
		"plugins": [{ "name": "next" }],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"src",
		".next/types/**/*.ts",
		"next.config.ts",
		"vitest.config.ts"
	],
	"exclude": ["node_modules", ".next"]
}
