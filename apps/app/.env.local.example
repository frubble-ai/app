# The app's local config (docs/environment.md). Copy to apps/app/.env.local; every value is
# optional. The server reads these at request time, as a stg or prd container reads its service's.

# Another API than your local one (http://localhost:8080/graphql), e.g. stg's. That API's
# CORS_ORIGIN must allow http://localhost:3000.
GRAPHQL_URL=
