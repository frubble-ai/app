{
	"name": "@frubble/backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"codegen": "graphql-codegen --config codegen.yml",
		"dev:api": "bun --env-file=.env.local --watch src/index.ts",
		"dev:worker": "APP_PROCESS=worker HOST=0.0.0.0 PORT=${WORKER_PORT:-8081} bun --env-file=.env.local --watch src/index.ts",
		"start": "bun run src/index.ts",
		"start:worker": "APP_PROCESS=worker bun run src/index.ts",
		"migrate": "bun --env-file=.env.local scripts/migrate.ts",
		"seed": "bun --env-file=.env.local scripts/seed.ts",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "biome check --error-on-warnings .",
		"format:write": "biome check --write ."
	},
	"dependencies": {
		"@frubble/db": "workspace:*",
		"@frubble/emails": "workspace:*",
		"@frubble/events": "workspace:*",
		"@frubble/gql": "workspace:*",
		"@google-cloud/pubsub": "^6.3.0",
		"@graphql-hive/logger": "^1.1.1",
		"better-auth": "^1.7.14",
		"drizzle-orm": "^0.45.4",
		"graphql": "^16.13.2",
		"graphql-yoga": "^6.0.1",
		"hono": "^4.13.14",
		"lru-cache": "^11.5.3",
		"luxon": "^3.7.2",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@faker-js/faker": "^10.6.0",
		"@frubble/seed": "workspace:*",
		"@graphql-codegen/add": "^7.1.1",
		"@graphql-codegen/cli": "^7.4.6",
		"@graphql-codegen/typescript-resolvers": "^6.1.1",
		"@testcontainers/postgresql": "^12.2.1",
		"@types/bun": "^1.4.4",
		"@types/luxon": "^3.7.6",
		"@types/pg": "^8.20.0",
		"@vitest/coverage-istanbul": "^5.0.5",
		"eslint": "^9.0.0",
		"pino-pretty": "^13.2.0",
		"typescript": "^5.7.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
