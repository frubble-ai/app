# Local development. Copy to .env.local; `yarn dev` loads it for the API and the worker.
# Never commit a real .env file.

APP_ENV=local

# --- Server ---
# The API binds loopback. The worker (`yarn dev`) binds every interface on WORKER_PORT (8081)
# instead, so the Pub/Sub emulator's container can push to it.
HOST=127.0.0.1
PORT=8080
# Browser origins allowed to call the API, comma-separated. None locally.
CORS_ORIGIN=

# --- Database (docker-compose; same values as the root .env.local) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=frubble
DB_USER=frubble
DB_PASSWORD=frubble_dev
# The server's CA, PEM, outside local only.
DB_CA_PEM=

# --- Better Auth ---
BETTER_AUTH_URL=http://localhost:8080
# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-32-random-characters!!

# --- Queue (Pub/Sub emulator from docker-compose) ---
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=frubble-local
PUBSUB_EMAILS_TOPIC=emails

# --- Email (the worker sends, the API reads EMAIL_PROVIDER too) ---
# none: the worker logs each email instead of sending it, and the API accepts the fixed code
# 111111 beside the emailed one. mailgun or resend: real email, with the provider's key and the
# sending domain registered there.
EMAIL_PROVIDER=none
# EMAIL_API_KEY=
# EMAIL_DOMAIN=stg.frubble.ai
# EMAIL_API_URL=
# EMAIL_FROM=noreply@frubble.ai
# EMAIL_FROM_NAME=Frubble
# EMAIL_SUPPORT_URL=

# --- Logging ---
# LOG_LEVEL=info
# json or pretty; json when NODE_ENV=production
# LOG_FORMAT=pretty
