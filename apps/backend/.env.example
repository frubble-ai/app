# Local development. Copy to .env.local; `yarn dev` loads it for the API and the worker.
# Never commit a real .env file.

APP_ENV=local

# --- Server ---
# The API binds loopback. The worker (`yarn dev`) binds every interface on WORKER_PORT (8081)
# instead, so the Pub/Sub emulator's container can push to it, and refuses a push without
# PUSH_TOKEN, which `yarn local:create` fills in below.
HOST=127.0.0.1
PORT=8080
# Browser origins allowed to call the API, comma-separated. None locally.
CORS_ORIGIN=http://localhost:3000

# --- Database (docker-compose; same values as the root .env.local) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=frubble
DB_USER=frubble
DB_PASSWORD=frubble_dev
# The server's CA, PEM, outside local only.
DB_CA_PEM=

# --- Better Auth ---
BETTER_AUTH_URL=http://localhost:8080
# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-32-random-characters!!

# The web app's origin: links in emails and the redirect after connecting a tool.
APP_URL=http://localhost:3000

# --- Composio (the stg project's key and auth configs, or your own); codegen needs the key too ---
COMPOSIO_API_KEY=
# provider=ac_… pairs, comma-separated: every provider the API knows.
COMPOSIO_AUTH_CONFIG_IDS=github=,linear=,slack=

# --- Osiris (frubble-ai/osiris), the broker new connections go through ---
# A local osiris's origin, as its README runs it.
OSIRIS_URL=http://localhost:8090
# Osiris's API key (not its admin key), at least 32 characters.
OSIRIS_API_KEY=
# provider=id pairs, comma-separated: our app at osiris for every provider the API knows.
OSIRIS_AUTH_CONFIG_IDS=github=,linear=,slack=

# --- GitHub ---
# The environment's GitHub App, as github.com/apps/<slug>: frubble-ai-dev locally and in dev,
# frubble-ai in stg. The install link opens it, and a connection lists only its installations.
GITHUB_APP_SLUG=frubble-ai-dev

# --- Queue (Pub/Sub emulator from docker-compose) ---
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=frubble-local
PUBSUB_EMAILS_TOPIC=emails

# --- Email (the worker) ---
# mailgun or resend, with the provider's key and the sending domain registered there.
EMAIL_PROVIDER=mailgun
EMAIL_API_KEY=
EMAIL_DOMAIN=stg.frubble.ai
# EMAIL_API_URL=
# EMAIL_FROM=noreply@stg.frubble.ai
# EMAIL_FROM_NAME=Frubble
# EMAIL_SUPPORT_URL=

# --- Logging ---
# LOG_LEVEL=info
# json or pretty; json when NODE_ENV=production
# LOG_FORMAT=pretty

# --- Worker push (set by yarn local:create) ---
PUSH_TOKEN=
