{
	"name": "@frubble/gql",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./types": "./src/__generated__/types.ts",
		"./validation": "./src/__generated__/validation.ts",
		"./schema/*": "./schema/*.graphql",
		"./operations/*": "./operations/**/*.graphql"
	},
	"scripts": {
		"codegen": "graphql-codegen --config codegen.yml",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "biome check --error-on-warnings .",
		"format:write": "biome check --write ."
	},
	"dependencies": {
		"@graphql-tools/load-files": "^7.0.1",
		"@graphql-tools/merge": "^9.2.7",
		"graphql": "^16.13.2",
		"luxon": "^3.7.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@faker-js/faker": "^10.6.0",
		"@graphql-codegen/add": "^7.1.1",
		"@graphql-codegen/cli": "^7.4.6",
		"@graphql-codegen/typescript": "^6.1.1",
		"@types/luxon": "^3.7.6",
		"@vitest/coverage-istanbul": "^5.0.5",
		"eslint": "^9.0.0",
		"graphql-codegen-typescript-validation-schema": "^0.19.0",
		"typescript": "^5.7.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
