{
	"name": "@frubble/react-sdk",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing/index.ts"
	},
	"scripts": {
		"codegen": "graphql-codegen --config codegen.yml",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "biome check --error-on-warnings .",
		"format:write": "biome check --write ."
	},
	"dependencies": {
		"@apollo/client": "^4.3.5",
		"@frubble/gql": "workspace:*",
		"@graphql-typed-document-node/core": "^3.2.0",
		"graphql": "^16.13.2",
		"rxjs": "^7.8.2"
	},
	"peerDependencies": {
		"react": ">=19"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@faker-js/faker": "^10.6.0",
		"@graphql-codegen/cli": "^7.4.6",
		"@graphql-codegen/introspection": "^6.1.0",
		"@graphql-codegen/typed-document-node": "^7.2.0",
		"@graphql-codegen/typescript-operations": "^6.2.0",
		"@graphql-codegen/typescript-react-apollo": "5.0.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.2.3",
		"@vitest/coverage-istanbul": "^5.0.5",
		"jsdom": "^30.1.3",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"typescript": "^5.7.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
