{
	"name": "@frubble/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts",
		"./migrate": "./src/lib/migrate.ts",
		"./env": "./src/lib/env.ts"
	},
	"scripts": {
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "biome check --error-on-warnings .",
		"format:write": "biome check --write ."
	},
	"dependencies": {
		"drizzle-orm": "^0.45.4",
		"luxon": "^3.7.2",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@faker-js/faker": "^10.6.0",
		"@types/luxon": "^3.7.6",
		"@types/pg": "^8.20.0",
		"@vitest/coverage-istanbul": "^5.0.5",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9.0.0",
		"typescript": "^5.7.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
